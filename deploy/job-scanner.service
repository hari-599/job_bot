[Unit]
Description=Telegram job scanner bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=job-scanner
Group=job-scanner
WorkingDirectory=/opt/job-scanner
EnvironmentFile=/etc/job-scanner/job-scanner.env
Environment=PYTHONUNBUFFERED=1
Environment=DB_PATH=/var/lib/job-scanner/jobbot.db
ExecStart=/opt/job-scanner/.venv/bin/python /opt/job-scanner/bot.py
Restart=on-failure
RestartSec=5
StateDirectory=job-scanner
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
